              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Connects per user",
      "description": "Reconnect churn per login. Shelly/EMS-ESP flap on Wi-Fi; Zigbee2MQTT and Home Assistant should be flat outside restarts.",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "editorMode": "code",
          "expr": "sum by (user) (count_over_time({namespace=\"smarthome\", pod=\"mosquitto-0\"} |= \"New client connected\" | regexp `from (?P<ip>[0-9.]+?)\\.\\d+:\\d+ as .*u'(?P<user>[^']*)'\\)` [$__interval]))",
          "legendFormat": "{{user}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "spanNulls": false
          },
          "noValue": "0"
        },
        "overrides": []
      }
    },
