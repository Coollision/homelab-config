    {
      "id": 10,
      "type": "timeseries",
      "title": "Publishes by topic root",
      "description": "Needs log_type all. Goes empty once the temporary logging is removed, that is expected. Subscribe topics are logged on a separate line from their client, so use scripts/mosquitto-acl-usage.sh for those.",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
