          "noValue": "0"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Distinct users (range)",
      "description": "Usernames that connected. Expected: admin, debug, emsChip, homeAssistant, moonraker, shelly, zigbee2mqtt.",
