    {
      "id": 7,
      "type": "timeseries",
      "title": "Rejected logins and disconnect reasons",
      "description": "Auth failures, keepalive timeouts and protocol errors. Timeouts are normal for flaky Wi-Fi devices; 'not authorised' is not.",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (count_over_time({namespace=\"smarthome\", pod=\"mosquitto-0\"} | regexp `(?P<reason>not authorised|exceeded timeout|protocol error|Socket error|closed its connection)` | reason != \"\" [$__interval]))",
          "legendFormat": "{{reason}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "sum"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 40,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "lineWidth": 1,
            "spanNulls": false
          },
          "noValue": "0"
        },
        "overrides": []
      }
