    {
      "id": 12,
      "type": "logs",
      "title": "Security-relevant broker lines",
      "description": "Auth failures, denied publishes, broker errors and warnings, newest first. Publish/subscribe traffic lines are excluded, so topic names that merely contain 'error' or 'bad' no longer match.",
      "datasource": {
        "type": "loki",
        "uid": "P8E80F9AEF21F6940"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "editorMode": "code",
          "expr": "{namespace=\"smarthome\", pod=\"mosquitto-0\"} !~ `(Received|Sending) (PUBLISH|SUBSCRIBE)` |~ `not authorised|Denied (PUBLISH|SUBSCRIBE)|Error:|Warning:|Socket error|protocol error|exceeded timeout`",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      }
    },
