        "y": 21
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P8E80F9AEF21F6940"
          },
          "editorMode": "code",
          "expr": "sum by (root) (count_over_time({namespace=\"smarthome\", pod=\"mosquitto-0\"} | regexp `Received PUBLISH from \\S+ \\(.*?, '(?P<root>[^/']+)` | root != \"\" [$__interval]))",
          "legendFormat": "{{root}}",
          "queryType": "range",
          "refId": "A"
