#!/bin/bash
# Managed by smb-operator. Reconciles /shares/* NFS mounts against the mount table.
TABLE=<% .Table %>
CONF=<% .Conf %>
OPTS='<% .Opts %>'
INTERVAL=<% .Interval %>

log() { echo "[mount-reconciler] $*"; }

# Current NFS mount for a path, as 'server:/export', or empty if not mounted.
current_mount() {
  awk -v p="$1" '$2==p && $3 ~ /^nfs/ {print $1}' /proc/self/mounts | tail -n 1
}

# Detach a mount. Try a clean unmount first, time-boxed because it can block on a
# dead server, then fall back to a lazy unmount which always succeeds immediately.
#
# Success is judged by the resulting state, not by exit codes: a umount killed by
# `timeout` can still complete in the kernel, so the mount is gone while every command
# in the chain reported failure. Trusting the rc there produced spurious "could not
# unmount" warnings and made the caller skip a reconcile cycle.
detach() {
  local mp="$1"
  timeout 5 umount "$mp" 2>/dev/null \
    || timeout 5 umount -f "$mp" 2>/dev/null \
    || umount -l "$mp" 2>/dev/null
  [ -z "$(current_mount "$mp")" ]
}

# Is a mounted share still answering? A stale NFS mount (the share-manager is gone because Longhorn
# detached the volume) makes every stat() block until the soft timeout, and smbd serves all of one
# client's shares from a single process, so one dead share would freeze the client's other shares
# too. The table only learns about a detach after the ConfigMap propagates (up to ~1 min), so the
# reconciler checks the mount itself. The probe is bounded and runs on the mount point only.
mount_alive() {
  timeout 3 stat -t "$1" >/dev/null 2>&1
}

# Unix time a path was last found stale; remounting is held off for STALE_HOLD seconds so a
# vanished endpoint that is still in the table is not retried on every pass.
declare -A STALE_AT
STALE_HOLD=20

# Placeholder shown while a share has no NFS mount. It lives in the local directory underneath the
# mount point, so the real mount hides it the moment the volume attaches and nothing has to clean up.
PLACEHOLDER='_Volume offline - data will appear shortly.txt'
write_placeholder() {
  local f="$1/$PLACEHOLDER"
  [ -e "$f" ] && return 0
  printf '%s\n' \
    'This volume is currently offline (its app is scaled to zero).' \
<% if .Wake %>    'Opening this share asked for it to be started; the data will appear here' \
    'within a minute or two. Refresh the folder to see it.' \
<% else %>    'It will be mounted here automatically once the app starts.' \
<% end %>    > "$f" 2>/dev/null || true
}

# Is this mount path listed in the table at all?
in_table() {
  awk -F'\t' -v p="$1" '$1 !~ /^#/ && $2 == p { found = 1 } END { exit !found }' "$TABLE"
}

# Bring one mount point in line with its desired endpoint ('' means keep it unmounted).
reconcile_one() {
  local mpath="$1" want="$2" have
  have="$(current_mount "$mpath")"
  # Every share path is created here, not at pod start, so shares added later need no pod roll.
  # Only when nothing is mounted there: mkdir -p stat()s the path, which blocks on a stale mount.
  [ -n "$have" ] || mkdir -p "$mpath"

  # A mount that no longer answers is dropped at once (lazy: it must not block), whatever the table
  # says, so smbd falls back to the empty directory underneath instead of hanging on dead NFS.
  if [ -n "$have" ] && ! mount_alive "$mpath"; then
    umount -l "$mpath" 2>/dev/null
    STALE_AT[$mpath]=$(date +%s)
    log "stale mount $have at $mpath dropped; serving empty share"
    have=""
  fi

  [ -n "$have" ] || write_placeholder "$mpath"

  [ "$want" = "$have" ] && return 0

  if [ -n "$have" ]; then
    if detach "$mpath"; then
      log "unmounted $have from $mpath"
    else
      log "WARNING: could not unmount $mpath (had $have)"
      return 1
    fi
  fi

  if [ -z "$want" ]; then
    log "$mpath is detached (no endpoint); serving empty share"
    return 0
  fi

  if [ $(( $(date +%s) - ${STALE_AT[$mpath]:-0} )) -lt "$STALE_HOLD" ]; then
    return 0
  fi

  if timeout 30 mount -t nfs -o "$OPTS" "$want" "$mpath"; then
    log "mounted $want -> $mpath"
  else
    log "mount failed: $want -> $mpath (will retry in ${INTERVAL}s)"
  fi
}

# Tell the running smbd to re-read smb.conf when the ConfigMap content changes. Existing client
# connections to other shares stay up (a reload, not a restart). The first pass only records the
# checksum: smbd is not running yet and reads the file itself on start.
LAST_CONF_SUM=""
reload_conf_if_changed() {
  local sum
  sum="$(cksum < "$CONF" 2>/dev/null)" || return 0
  [ -n "$sum" ] && [ "$sum" != "$LAST_CONF_SUM" ] || return 0
  if [ -z "$LAST_CONF_SUM" ]; then
    LAST_CONF_SUM="$sum"
  elif smbcontrol smbd reload-config 2>/dev/null; then
    LAST_CONF_SUM="$sum"
    log "smb.conf changed; smbd reloaded"
  else
    log "smb.conf changed; smbd reload failed (will retry in ${INTERVAL}s)"
  fi
}

log "started (interval=${INTERVAL}s, opts=${OPTS})"

while true; do
  if [ -r "$TABLE" ]; then
    while IFS=$'\t' read -r name mpath endpoint; do
      case "$name" in ''|'#'*) continue ;; esac
      [ -n "$mpath" ] || continue
      reconcile_one "$mpath" "$endpoint"
    done < "$TABLE"

    # Drop any /shares/* NFS mount the table no longer knows about.
    while read -r src mp fstype _; do
      case "$fstype" in nfs*) ;; *) continue ;; esac
      case "$mp" in /shares/*) ;; *) continue ;; esac
      if ! in_table "$mp"; then
        detach "$mp" && log "unmounted orphaned $src from $mp"
      fi
    done < /proc/self/mounts
  else
    log "mount table $TABLE not readable yet"
  fi
  reload_conf_if_changed
  sleep "$INTERVAL"
done
