 {
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":timezone(Europe/Brussels)"],
  "schedule": ["after 7pm and before 10pm"],
  "baseBranchPatterns": ["$default", "orphan/aws-tunnels-operator-standalone", "orphan/storage-operator-standalone"],
  "kubernetes": {
    "managerFilePatterns": ["/\\.yaml$/"],
    "ignorePaths": ["lib/**"]
  },
  "packageRules": [
    {
      "description": "MariaDB - stay on the 12.3 LTS line (13.0 is a short-lived rolling release; auto-upgrade makes downgrade unsupported). Revisit at 13.3 LTS.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["mariadb"],
      "allowedVersions": "<13"
    },
    {
      "description": "System & ArgoCD - automerge patch and minor",
      "matchBaseBranches": ["master"],
      "matchFileNames": ["system/**", "argocd/**"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "matchUpdateTypes": ["patch", "minor"],
      "automergeSchedule": ["after 1am and before 5am"]
    },
    {
      "description": "Workload - automerge patch only",
      "matchBaseBranches": ["master"],
      "matchFileNames": ["workload/**"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "matchUpdateTypes": ["patch"],
      "automergeSchedule": ["after 1am and before 5am"]
    },
    {
      "description": "Noisy platform charts - one weekly PR for minor and patch (cuts ~200 commits/yr; automerge rule above still applies)",
      "matchBaseBranches": ["master"],
      "matchPackageNames": ["argo-cd", "kube-prometheus-stack"],
      "matchUpdateTypes": ["patch", "minor"],
      "schedule": ["on saturday"],
      "groupName": "platform charts",
      "groupSlug": "platform-charts"
    },
    {
      "description": "Noisy smarthome images - one weekly PR for patch bumps",
      "matchBaseBranches": ["master"],
      "matchPackageNames": ["ghcr.io/home-assistant/home-assistant", "ghcr.io/esphome/esphome"],
      "matchUpdateTypes": ["patch"],
      "schedule": ["on saturday"],
      "groupName": "smarthome images",
      "groupSlug": "smarthome-images"
    },
    {
      "description": "Operator branch - weekly grouped minor and patch updates",
      "matchBaseBranches": ["orphan/aws-tunnels-operator-standalone", "orphan/storage-operator-standalone"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "schedule": ["on sunday"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ]
}
