# Example inventory (structure only). Copy to ../inventory/ (gitignored) and fill in.
# Addresses use documentation ranges (RFC 5737 / RFC 3849); example.internal stands in for <internal-domain>.

[k3scluster:children]
k3smaster
k3sworkers

[k3smaster:children]
mini
vm

[k3sworkers:children]
rpi

[nodes:children]
vm
mini
rpi

[rpi]
node-b ansible_host=node-b.example.internal
node-g ansible_host=node-g.example.internal
node-r ansible_host=node-r.example.internal

[vm]
node-s ansible_host=node-s.example.internal

[mini]
node-gn ansible_host=node-gn.example.internal
node-be ansible_host=node-be.example.internal
